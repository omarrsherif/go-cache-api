# Copy to .env and adjust. .env is git-ignored.
# These defaults match docker-compose.yml (MySQL on 3307, Redis on 6380).

# Required
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=cache_api

# Used by docker-compose.yml for the MySQL root account
MYSQL_ROOT_PASSWORD=change-me-too

# Optional (defaults shown)
#REDIS_ADDR=127.0.0.1:6380
#SERVER_PORT=8080
#LOG_LEVEL=info              # debug logs one line per request
#CACHE_TTL=60s
#REDIS_OP_TIMEOUT=100ms      # per Redis command; on expiry the request falls back to MySQL
#REDIS_POOL_SIZE=100
#REQUEST_TIMEOUT=5s
#SHUTDOWN_TIMEOUT=10s
#SHUTDOWN_DRAIN_DELAY=0s     # set to ~2x your load balancer's probe interval so it sees /readyz fail first
#BATCH_WORKERS=8             # default worker-pool size for POST /products/batch (max 64)
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=25
#DB_CONN_MAX_LIFETIME=5m
