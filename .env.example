# Copy this file to .env and adjust the values. .env is ignored by git.
# These defaults match the docker commands in the README.

# MySQL configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=cache_api

# Redis configuration
REDIS_ADDR=127.0.0.1:6380

# HTTP server configuration
SERVER_PORT=8080
